# ─── Environment ─────────────────────────────────────────────────────────────
# Active environment: development | test | production
# Defaults to "development" when unset.  Must be set explicitly in production.
# The seed script refuses to run when ENVIRONMENT=production.
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the FastAPI backend and Alembic.
# Docker Compose overrides this automatically — the value here is only used
# when running the backend outside Docker (local venv, CI).
# Production example: postgresql://user:pass@neon.tech:5432/configtrace
DATABASE_URL=postgresql://configtrace:configtrace@db:5432/configtrace

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection string used as the Celery broker and result backend.
# Docker Compose overrides this automatically.
# Production example: redis://default:token@upstash-endpoint:6379
REDIS_URL=redis://redis:6379/0

# ─── Application secrets ─────────────────────────────────────────────────────
# Random secret used for signing tokens. Generate with:
#   openssl rand -hex 32
SECRET_KEY=replace-with-a-random-64-char-hex-string

# ─── Clerk authentication (Milestone 21) ─────────────────────────────────────
#
# BACKEND (FastAPI): JWT verification uses Clerk's JWKS public-key endpoint.
# Find the URL in your Clerk dashboard → API Keys → "Show JWT public key" →
# "JWKS URL".  Typical shape:
#   https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
#
# - When CLERK_JWKS_URL is unset locally AND ENVIRONMENT != production, the
#   backend falls back to dev mode (auto-creates dev@configtrace.local).
# - When CLERK_JWKS_URL is unset in production, every protected route
#   returns HTTP 503.  Production never falls back to dev mode.
CLERK_JWKS_URL=

# Optional: when set, the JWT `iss` claim must match exactly.  Skip for now
# unless you've configured a custom issuer in Clerk.
# CLERK_ISSUER=

# Backend secret key from your Clerk dashboard.  NOT used by JWT verification
# (that uses JWKS above).  Reserved for future Clerk management-API calls.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# FRONTEND (Next.js): public key embedded in the browser bundle.
#
# REQUIRED for the frontend to boot after Milestone 21 — Clerk throws on
# initialization if this is missing.  Local development: create a free Clerk
# development application (~2 minutes) at https://dashboard.clerk.com and copy
# the pk_test_... value here.  See docs/deployment.md for screenshots.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32-byte AES-GCM key, base64-encoded.  Used to encrypt Cloudflare API tokens
# at rest.  MUST be generated securely and stored in a secrets manager in prod.
# Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the backend API from a browser.
# Local development default covers the Next.js dev server.
# Production: set to your exact frontend origin(s) — no trailing slash.
#   BACKEND_CORS_ORIGINS=https://app.configtrace.org,https://configtrace.org
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend, used by the Next.js API client.
# This value is embedded in the browser bundle (NEXT_PUBLIC_ prefix).
# Local default: http://localhost:8000
# Production: https://api.configtrace.org
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── PostgreSQL service (Docker Compose only) ────────────────────────────────
# Used by the docker-compose.yml postgres service to initialise the database.
# Not read by the FastAPI backend directly (it uses DATABASE_URL above).
POSTGRES_DB=configtrace
POSTGRES_USER=configtrace
POSTGRES_PASSWORD=configtrace
