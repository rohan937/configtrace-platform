# ─────────────────────────────────────────────────────────────────────────────
# ConfigTrace — Production Environment Template
#
# Copy to .env (or set directly in your hosting platform's secrets/env panel).
# NEVER commit the filled-in version of this file.
# Each value marked REQUIRED must be set before the service will start.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Environment ─────────────────────────────────────────────────────────────
# REQUIRED.  Must be "production" in production deployments.
# The seed script (seed_dev_data.py) refuses to run when this is set.
ENVIRONMENT=production

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Hosted PostgreSQL connection string.
# Recommended providers: Neon, Supabase, Render Postgres
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://configtrace_user:CHANGE_ME@your-db-host.neon.tech:5432/configtrace

# ─── Redis (REQUIRED) ────────────────────────────────────────────────────────
# Hosted Redis connection string (Celery broker + result backend).
# Recommended providers: Upstash, Render Redis
# Format: redis://default:token@your-redis-host:6379
REDIS_URL=redis://default:CHANGE_ME@your-redis-host.upstash.io:6379

# ─── Application secrets (REQUIRED) ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─── Clerk authentication (REQUIRED for production auth) ─────────────────────
# From your Clerk dashboard (https://dashboard.clerk.com → API Keys).
CLERK_SECRET_KEY=sk_live_CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME

# ─── Credential encryption (REQUIRED) ────────────────────────────────────────
# 32-byte AES-GCM key, base64-encoded.  Store in a secrets manager (e.g.
# Doppler, Infisical, AWS Secrets Manager).  Rotating this key will break
# decryption of all stored integration credentials.
# Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_base64_encoded_32_byte_key

# ─── CORS (REQUIRED) ─────────────────────────────────────────────────────────
# Exact frontend origin(s) that may call the API from a browser.
# No trailing slashes.  No wildcards.
BACKEND_CORS_ORIGINS=https://app.configtrace.org,https://configtrace.org

# ─── Frontend API base URL (REQUIRED — set in Vercel/hosting env panel) ──────
# The browser-facing URL of the backend API.
# This is embedded in the Next.js bundle at build time (NEXT_PUBLIC_ prefix).
# Set this in your Vercel project settings, not in a .env file on Vercel.
NEXT_PUBLIC_API_BASE_URL=https://api.configtrace.org

# ─── NOT USED in production (Docker Compose only) ────────────────────────────
# These are only consumed by the local docker-compose.yml postgres service.
# Do not set them in hosted environments.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
